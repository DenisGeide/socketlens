  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 1420",
    "dev:desktop": "tauri dev",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "build:desktop": "tauri build",
